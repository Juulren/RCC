# Plantilla. ASP.NET no carga .env; Docker Compose sí lee .env de la raíz.
# Copiar a .env para Docker Compose y reemplazar antes de iniciar.
POSTGRES_DB=rcc
POSTGRES_USER=rcc
POSTGRES_PASSWORD=REPLACE_WITH_A_LOCAL_PASSWORD
# Para ASP.NET use user-secrets o establezca esta variable en su terminal.
# ConnectionStrings__Rcc=Host=localhost;Port=5432;Database=rcc;Username=rcc;Password=YOUR_LOCAL_PASSWORD
# Pruebas: el usuario necesita permiso CREATEDB; nunca apuntar a producción.
# RCC_TEST_POSTGRES=Host=localhost;Port=5432;Database=postgres;Username=rcc;Password=YOUR_LOCAL_PASSWORD
# Stripe sandbox: configurar mediante user-secrets, no escribir claves aquí.
# Stripe__SecretKey=sk_test_YOUR_SANDBOX_KEY
# Stripe__WebhookSecret=whsec_YOUR_ENDPOINT_SECRET
# Stripe__PublicOrigin=http://localhost:5080

# Servicios externos (API ASP.NET; preferir user-secrets localmente):
# GoogleMaps__EmbedKey=clave-publica-restringida-a-Maps-Embed-y-tu-dominio
# Resend__Enabled=false
# Resend__ApiKey=usar-user-secrets-no-commitear
# Resend__From=RCC <reservas@tu-dominio-verificado>
